---
import Layout from '../../layouts/Layout.astro';
import CtaBand from '../../components/CtaBand.astro';
import { sortedPosts } from '../../data/blogs';
import { breadcrumbSchema, organizationSchema } from '../../lib/schema';
import { formatDate } from '../../lib/utils';

const posts = sortedPosts();
const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Guides', path: '/blog/' },
];
---

<Layout
  title="Drywall Guides for Bay Area Homeowners | Diablo Valley Drywall"
  description="Practical drywall guides: repair costs, recurring cracks, popcorn ceiling asbestos, ceiling water stains, texture types, plaster vs drywall and finish levels."
  canonical="/blog/"
  schemas={[organizationSchema(), breadcrumbSchema(crumbs)]}
>
  <section class="bg-brand-900">
    <div class="mx-auto max-w-6xl px-4 py-14 lg:py-20">
      <nav aria-label="Breadcrumb" class="text-xs text-brand-400">
        <a href="/" class="hover:text-white">Home</a>
        <span class="px-1.5">/</span>
        <span class="text-brand-200">Guides</span>
      </nav>
      <h1 class="mt-5 max-w-3xl text-3xl font-black leading-tight tracking-tight text-white sm:text-4xl">
        Drywall guides for Contra Costa homeowners
      </h1>
      <p class="mt-5 max-w-2xl text-lg leading-relaxed text-brand-200">
        Straight answers on what things cost, why repairs fail, and when the wall is telling you
        something more serious.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-4xl px-4 py-16">
    <div class="divide-y divide-brand-100">
      {
        posts.map((p) => (
          <article class="py-8 first:pt-0">
            <p class="text-xs font-bold uppercase tracking-wider text-accent-600">{p.category}</p>
            <h2 class="mt-2 text-2xl font-bold leading-snug tracking-tight text-brand-900">
              <a class="hover:text-accent-700" href={`/blog/${p.slug}/`}>
                {p.title}
              </a>
            </h2>
            <p class="mt-3 leading-relaxed text-brand-600">{p.intro}</p>
            <p class="mt-4 text-xs text-brand-500">
              {formatDate(p.publishedDate)} · {p.readMinutes} min read
            </p>
          </article>
        ))
      }
    </div>
  </section>

  <CtaBand />
</Layout>
