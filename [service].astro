---
import Layout from '../../layouts/Layout.astro';
import QuoteForm from '../../components/QuoteForm.astro';
import Faq from '../../components/Faq.astro';
import CtaBand from '../../components/CtaBand.astro';
import { services, serviceBySlug } from '../../data/services';
import { cities, cityNames } from '../../data/cities';
import { globalFaqs } from '../../data/faqs';
import { serviceSchema, faqSchema, breadcrumbSchema } from '../../lib/schema';
import { PHONE_DISPLAY, PHONE_HREF } from '../../lib/utils';

export function getStaticPaths() {
  return services.map((s) => ({ params: { service: s.slug } }));
}

const { service: slug } = Astro.params;
const service = serviceBySlug(slug!)!;

/** Cities whose page features this service — good internal linking. */
const featuredIn = cities.filter((c) => c.services.some((s) => s.slug === service.slug));

const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Services', path: '/services/' },
  { name: service.name, path: `/services/${service.slug}/` },
];
---

<Layout
  title={service.metaTitle}
  description={service.metaDescription}
  canonical={`/services/${service.slug}/`}
  schemas={[
    serviceSchema(service, cityNames()),
    faqSchema(globalFaqs),
    breadcrumbSchema(crumbs),
  ]}
>
  <section class="bg-brand-900">
    <div class="mx-auto grid max-w-6xl gap-10 px-4 py-14 lg:grid-cols-5 lg:py-20">
      <div class="lg:col-span-3">
        <nav aria-label="Breadcrumb" class="text-xs text-brand-400">
          <a href="/" class="hover:text-white">Home</a>
          <span class="px-1.5">/</span>
          <a href="/services/" class="hover:text-white">Services</a>
          <span class="px-1.5">/</span>
          <span class="text-brand-200">{service.name}</span>
        </nav>
        <h1 class="mt-5 text-3xl font-black leading-tight tracking-tight text-white sm:text-4xl">
          {service.name}
        </h1>
        <p class="mt-5 text-lg leading-relaxed text-brand-200">{service.longDescription}</p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a
            href="#quote"
            class="rounded-lg bg-accent-600 px-6 py-3.5 text-sm font-bold text-white shadow-lg transition hover:bg-accent-700"
            >Get a free quote</a
          >
          <a
            href={PHONE_HREF}
            class="rounded-lg border border-brand-600 px-6 py-3.5 text-sm font-bold text-white transition hover:border-brand-400"
            >Call {PHONE_DISPLAY}</a
          >
        </div>
      </div>
      <div class="lg:col-span-2">
        <div class="rounded-2xl bg-white p-5 shadow-2xl sm:p-6">
          <p class="text-lg font-bold text-brand-900">Quote for {service.name.toLowerCase()}</p>
          <div class="mt-4">
            <QuoteForm id="quote" service={service.slug} compact />
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-16">
    <div class="grid gap-10 lg:grid-cols-3">
      <div class="lg:col-span-2">
        <h2 class="text-2xl font-bold tracking-tight text-brand-900">What this covers</h2>
        <ul class="mt-6 grid gap-3 sm:grid-cols-2">
          {
            service.bullets.map((b) => (
              <li class="flex gap-3 rounded-lg border border-brand-100 p-4 text-sm text-brand-700">
                <span class="mt-0.5 text-accent-500" aria-hidden="true">
                  ▪
                </span>
                <span>{b}</span>
              </li>
            ))
          }
        </ul>
      </div>
      <aside class="rounded-xl border border-brand-100 bg-brand-50 p-6">
        <h2 class="text-sm font-bold uppercase tracking-wider text-brand-900">On pricing</h2>
        <p class="mt-3 text-sm leading-relaxed text-brand-700">{service.priceNote}</p>
        <p class="mt-4 text-sm leading-relaxed text-brand-600">
          Quotes are free and written. On most repairs we can give you a firm range from photos
          before anyone drives out.
        </p>
      </aside>
    </div>
  </section>

  {
    featuredIn.length > 0 && (
      <section class="border-y border-brand-100 bg-brand-50">
        <div class="mx-auto max-w-6xl px-4 py-14">
          <h2 class="text-xl font-bold tracking-tight text-brand-900">
            {service.name} by city
          </h2>
          <p class="mt-2 text-sm text-brand-600">
            What this job typically involves in each community.
          </p>
          <div class="mt-6 flex flex-wrap gap-3">
            {featuredIn.map((c) => (
              <a
                href={`/locations/${c.slug}/`}
                class="rounded-lg border border-brand-200 bg-white px-4 py-2.5 text-sm font-semibold text-brand-800 transition hover:border-accent-400 hover:text-accent-700"
              >
                {service.name} in {c.name}
              </a>
            ))}
          </div>
        </div>
      </section>
    )
  }

  <Faq faqs={globalFaqs} />
  <CtaBand />
</Layout>
