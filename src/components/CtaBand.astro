---
import { PHONE_DISPLAY, PHONE_HREF, RESPONSE_PROMISE } from '../lib/utils';

export interface Props {
  heading?: string;
  sub?: string;
}
const {
  heading = 'Get a straight answer on your drywall repair',
  sub = RESPONSE_PROMISE,
} = Astro.props;
---

<section class="bg-brand-900">
  <div
    class="mx-auto flex max-w-6xl flex-col items-start gap-6 px-4 py-14 sm:flex-row sm:items-center sm:justify-between"
  >
    <div>
      <h2 class="text-2xl font-bold tracking-tight text-white sm:text-3xl">{heading}</h2>
      <p class="mt-2 max-w-xl text-sm text-brand-300">{sub}</p>
    </div>
    <div class="flex shrink-0 flex-wrap gap-3">
      <a
        href={PHONE_HREF}
        class="rounded-lg border border-brand-600 px-5 py-3 text-sm font-bold text-white transition hover:border-brand-400"
        >{PHONE_DISPLAY}</a
      >
      <a
        href="/contact/"
        class="rounded-lg bg-accent-600 px-5 py-3 text-sm font-bold text-white shadow transition hover:bg-accent-700"
        >Get a free quote</a
      >
    </div>
  </div>
</section>
