---
import Layout from '../../layouts/Layout.astro';
import CtaBand from '../../components/CtaBand.astro';
import Faq from '../../components/Faq.astro';
import { services } from '../../data/services';
import { globalFaqs } from '../../data/faqs';
import { breadcrumbSchema, faqSchema, organizationSchema } from '../../lib/schema';

const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Services', path: '/services/' },
];
---

<Layout
  title="Drywall Services | Repair, Ceilings, Texture & Installation"
  description="Drywall repair, ceiling repair, water damage repair, texture matching, popcorn ceiling removal and new installation across the Diablo Valley."
  canonical="/services/"
  schemas={[organizationSchema(), faqSchema(globalFaqs), breadcrumbSchema(crumbs)]}
>
  <section class="bg-brand-900">
    <div class="mx-auto max-w-6xl px-4 py-14 lg:py-20">
      <nav aria-label="Breadcrumb" class="text-xs text-brand-400">
        <a href="/" class="hover:text-white">Home</a>
        <span class="px-1.5">/</span>
        <span class="text-brand-200">Services</span>
      </nav>
      <h1 class="mt-5 max-w-3xl text-3xl font-black leading-tight tracking-tight text-white sm:text-4xl">
        Drywall services across the Diablo Valley
      </h1>
      <p class="mt-5 max-w-2xl text-lg leading-relaxed text-brand-200">
        One trade, done to a finish standard. Every repair is textured and primed before we leave,
        because a bare patch is not a finished job.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-16">
    <div class="grid gap-6 md:grid-cols-2">
      {
        services.map((s) => (
          <a
            href={`/services/${s.slug}/`}
            class="group rounded-xl border border-brand-100 p-7 transition hover:border-accent-300 hover:shadow-lg"
          >
            <span class="text-2xl" aria-hidden="true">
              {s.icon}
            </span>
            <h2 class="mt-3 text-xl font-bold text-brand-900 group-hover:text-accent-700">
              {s.name}
            </h2>
            <p class="mt-2 text-sm leading-relaxed text-brand-600">{s.longDescription}</p>
            <p class="mt-4 text-sm font-semibold text-accent-600">See details →</p>
          </a>
        ))
      }
    </div>
  </section>

  <Faq faqs={globalFaqs} />
  <CtaBand />
</Layout>
