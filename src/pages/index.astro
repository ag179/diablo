---
import Layout from '../layouts/Layout.astro';
import QuoteForm from '../components/QuoteForm.astro';
import Faq from '../components/Faq.astro';
import CtaBand from '../components/CtaBand.astro';
import { services } from '../data/services';
import { cities, citiesByTier } from '../data/cities';
import { globalFaqs } from '../data/faqs';
import { reviews } from '../data/reviews';
import { sortedPosts } from '../data/blogs';
import { organizationSchema, faqSchema } from '../lib/schema';
import { PHONE_DISPLAY, PHONE_HREF, REGION_LONG } from '../lib/utils';

const tier1 = citiesByTier(1);
const posts = sortedPosts().slice(0, 3);

const title = 'Drywall Repair in Walnut Creek & the Diablo Valley | Diablo Valley Drywall';
const description =
  'Drywall repair, ceiling repair, water damage and texture matching across Walnut Creek, Concord, Danville and the wider Diablo Valley. Free written quotes.';

const trust = [
  { label: 'Free written quotes', note: 'Firm range from photos on most repairs.' },
  { label: 'Texture matched', note: 'Blended and primed, not left as a bright square.' },
  { label: 'Tested before scraped', note: 'Asbestos testing first on any pre-1980 ceiling.' },
  { label: 'One trade, done right', note: 'Drywall is all we do, so the finish is the point.' },
];
---

<Layout
  title={title}
  description={description}
  canonical="/"
  schemas={[organizationSchema(), faqSchema(globalFaqs)]}
>
  <!-- Hero -->
  <section class="relative overflow-hidden bg-brand-900">
    <div
      class="pointer-events-none absolute inset-0 opacity-[0.07]"
      style="background-image:linear-gradient(#fff 1px,transparent 1px),linear-gradient(90deg,#fff 1px,transparent 1px);background-size:64px 64px"
      aria-hidden="true"
    >
    </div>
    <div class="relative mx-auto grid max-w-6xl gap-10 px-4 py-16 lg:grid-cols-5 lg:py-24">
      <div class="lg:col-span-3">
        <p
          class="inline-flex items-center rounded-full border border-brand-700 bg-brand-800 px-3 py-1 text-xs font-semibold uppercase tracking-wider text-accent-300"
        >
          Serving {REGION_LONG}
        </p>
        <h1 class="mt-5 text-4xl font-black leading-[1.08] tracking-tight text-white sm:text-5xl">
          Drywall and ceiling repair that
          <span class="text-accent-400">actually disappears</span> into the wall.
        </h1>
        <p class="mt-5 max-w-xl text-lg leading-relaxed text-brand-200">
          Holes, cracks, water stains, failed seams and popped nails — cut back, re-taped, textured
          to match and primed ready for paint. Across Walnut Creek, Concord, Danville and the rest
          of the valley.
        </p>
        <div class="mt-8 flex flex-wrap items-center gap-3">
          <a
            href="#quote"
            class="rounded-lg bg-accent-600 px-6 py-3.5 text-sm font-bold text-white shadow-lg transition hover:bg-accent-700"
            >Get a free quote</a
          >
          <a
            href={PHONE_HREF}
            class="rounded-lg border border-brand-600 px-6 py-3.5 text-sm font-bold text-white transition hover:border-brand-400"
            >Call {PHONE_DISPLAY}</a
          >
        </div>
        <p class="mt-6 text-sm text-brand-400">
          Send a photo and we can usually tell you the price range before anyone drives out.
        </p>
      </div>

      <div class="lg:col-span-2">
        <div class="rounded-2xl bg-white p-5 shadow-2xl sm:p-6">
          <p class="text-lg font-bold text-brand-900">Tell us what happened</p>
          <p class="mt-1 text-sm text-brand-600">
            Free quote, no obligation. Most requests answered the same business day.
          </p>
          <div class="mt-5">
            <QuoteForm id="quote" compact />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Trust strip -->
  <section class="border-b border-brand-100 bg-brand-50">
    <div class="mx-auto grid max-w-6xl gap-6 px-4 py-8 sm:grid-cols-2 lg:grid-cols-4">
      {
        trust.map((t) => (
          <div>
            <p class="text-sm font-bold text-brand-900">{t.label}</p>
            <p class="mt-1 text-xs leading-relaxed text-brand-600">{t.note}</p>
          </div>
        ))
      }
    </div>
  </section>

  <!-- Services -->
  <section class="mx-auto max-w-6xl px-4 py-16 lg:py-20">
    <div class="max-w-2xl">
      <h2 class="text-3xl font-bold tracking-tight text-brand-900">What we fix</h2>
      <p class="mt-3 text-brand-600">
        Drywall is the whole business. That is why the patch blends instead of announcing itself.
      </p>
    </div>
    <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {
        services.map((s) => (
          <a
            href={`/services/${s.slug}/`}
            class="group rounded-xl border border-brand-100 p-6 transition hover:border-accent-300 hover:shadow-lg"
          >
            <span class="text-2xl" aria-hidden="true">
              {s.icon}
            </span>
            <h3 class="mt-3 text-lg font-bold text-brand-900 group-hover:text-accent-700">
              {s.name}
            </h3>
            <p class="mt-2 text-sm leading-relaxed text-brand-600">{s.shortDescription}</p>
            <p class="mt-4 text-sm font-semibold text-accent-600">Learn more →</p>
          </a>
        ))
      }
    </div>
  </section>

  <!-- Why -->
  <section class="border-y border-brand-100 bg-brand-50">
    <div class="mx-auto grid max-w-6xl gap-10 px-4 py-16 lg:grid-cols-2 lg:py-20">
      <div>
        <h2 class="text-3xl font-bold tracking-tight text-brand-900">
          Most "drywall repairs" fail at the last ten percent
        </h2>
        <p class="mt-4 leading-relaxed text-brand-700">
          Cutting a square and screwing in a patch is the easy part. What separates a repair you
          can see from one you cannot is the width of the float, the texture match, and whether
          anyone bothered to prime before the paint went on.
        </p>
        <p class="mt-4 leading-relaxed text-brand-700">
          It is also why so many valley homeowners have the same crack filled three times. A seam
          crack is a taping failure — filler on top of failed tape bridges nothing, and it will
          reopen the next dry season.
        </p>
      </div>
      <dl class="grid gap-6 sm:grid-cols-2">
        <div>
          <dt class="font-bold text-brand-900">Cut, tape, float wide</dt>
          <dd class="mt-1 text-sm leading-relaxed text-brand-600">
            Failed tape comes out. Joints are re-taped and floated eight to twelve inches either
            side so no single line carries the stress.
          </dd>
        </div>
        <div>
          <dt class="font-bold text-brand-900">Texture matched on site</dt>
          <dd class="mt-1 text-sm leading-relaxed text-brand-600">
            Sprayed or hand-troweled to match what is already there — with a sample panel first on
            anything unusual.
          </dd>
        </div>
        <div>
          <dt class="font-bold text-brand-900">Primed before we leave</dt>
          <dd class="mt-1 text-sm leading-relaxed text-brand-600">
            New compound drinks paint differently from an old wall. Priming is what makes the sheen
            match, and it is standard, not an extra.
          </dd>
        </div>
        <div>
          <dt class="font-bold text-brand-900">Told straight when it is not drywall</dt>
          <dd class="mt-1 text-sm leading-relaxed text-brand-600">
            If your crack is a foundation problem or your wall is plaster, you will hear that
            rather than get sold a patch that is guaranteed to fail.
          </dd>
        </div>
      </dl>
    </div>
  </section>

  {
    reviews.length > 0 && (
      <section class="mx-auto max-w-6xl px-4 py-16">
        <h2 class="text-3xl font-bold tracking-tight text-brand-900">What customers say</h2>
        <div class="mt-8 grid gap-6 md:grid-cols-3">
          {reviews.slice(0, 3).map((r) => (
            <figure class="rounded-xl border border-brand-100 p-6">
              <p class="text-sm text-accent-500" aria-label={`${r.rating} out of 5`}>
                {'★'.repeat(r.rating)}
              </p>
              <blockquote class="mt-3 text-sm leading-relaxed text-brand-700">“{r.text}”</blockquote>
              <figcaption class="mt-4 text-xs font-semibold text-brand-900">
                {r.author} — {r.city}
                <span class="block font-normal text-brand-500">via {r.source}</span>
              </figcaption>
            </figure>
          ))}
        </div>
      </section>
    )
  }

  <!-- Service areas -->
  <section class="mx-auto max-w-6xl px-4 py-16 lg:py-20">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div class="max-w-2xl">
        <h2 class="text-3xl font-bold tracking-tight text-brand-900">Where we work</h2>
        <p class="mt-3 text-brand-600">
          {cities.length} communities across Contra Costa and the Tri-Valley. Each one has its own housing
          stock and its own drywall problems — pick yours.
        </p>
      </div>
      <a href="/locations/" class="text-sm font-semibold text-accent-600 hover:text-accent-700"
        >All service areas →</a
      >
    </div>

    <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        tier1.map((c) => (
          <a
            href={`/locations/${c.slug}/`}
            class="group flex items-start justify-between gap-4 rounded-xl border border-brand-100 p-5 transition hover:border-accent-300 hover:shadow-md"
          >
            <span>
              <span class="block font-bold text-brand-900 group-hover:text-accent-700">
                {c.name}, {c.state}
              </span>
              <span class="mt-1 block text-xs text-brand-500">
                {c.zips.join(' · ')}
              </span>
            </span>
            <span class="text-accent-500" aria-hidden="true">
              →
            </span>
          </a>
        ))
      }
    </div>

    <p class="mt-6 text-sm text-brand-600">
      Also serving {
        cities
          .filter((c) => c.tier !== 1)
          .map((c) => c.name)
          .join(', ')
      }.
    </p>
  </section>

  <!-- Blog -->
  <section class="border-t border-brand-100 bg-brand-50">
    <div class="mx-auto max-w-6xl px-4 py-16">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <h2 class="text-3xl font-bold tracking-tight text-brand-900">Guides</h2>
        <a href="/blog/" class="text-sm font-semibold text-accent-600 hover:text-accent-700"
          >All guides →</a
        >
      </div>
      <div class="mt-8 grid gap-6 md:grid-cols-3">
        {
          posts.map((p) => (
            <a
              href={`/blog/${p.slug}/`}
              class="group rounded-xl border border-brand-100 bg-white p-6 transition hover:border-accent-300 hover:shadow-lg"
            >
              <p class="text-xs font-bold uppercase tracking-wider text-accent-600">{p.category}</p>
              <h3 class="mt-2 text-lg font-bold leading-snug text-brand-900 group-hover:text-accent-700">
                {p.title}
              </h3>
              <p class="mt-2 text-sm leading-relaxed text-brand-600">{p.intro}</p>
              <p class="mt-4 text-xs text-brand-500">{p.readMinutes} min read</p>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <Faq faqs={globalFaqs} />

  <CtaBand />
</Layout>
