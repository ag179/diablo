---
import Layout from '../layouts/Layout.astro';
import QuoteForm from '../components/QuoteForm.astro';
import { cities } from '../data/cities';
import { globalFaqs } from '../data/faqs';
import { organizationSchema, breadcrumbSchema, faqSchema } from '../lib/schema';
import {
  PHONE_DISPLAY,
  PHONE_HREF,
  COMPANY_EMAIL,
  HOURS,
  RESPONSE_PROMISE,
  REGION_LONG,
} from '../lib/utils';

const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Contact', path: '/contact/' },
];
---

<Layout
  title="Get a Free Drywall Repair Quote | Diablo Valley Drywall"
  description={`Free drywall and ceiling repair quotes across ${REGION_LONG}. Send a photo and a short description — most requests are answered the same business day.`}
  canonical="/contact/"
  schemas={[organizationSchema(), faqSchema(globalFaqs), breadcrumbSchema(crumbs)]}
>
  <section class="bg-brand-900">
    <div class="mx-auto max-w-6xl px-4 py-14">
      <nav aria-label="Breadcrumb" class="text-xs text-brand-400">
        <a href="/" class="hover:text-white">Home</a>
        <span class="px-1.5">/</span>
        <span class="text-brand-200">Contact</span>
      </nav>
      <h1 class="mt-5 text-3xl font-black leading-tight tracking-tight text-white sm:text-4xl">
        Get a free quote
      </h1>
      <p class="mt-4 max-w-2xl text-lg text-brand-200">{RESPONSE_PROMISE}</p>
    </div>
  </section>

  <section class="mx-auto grid max-w-6xl gap-12 px-4 py-16 lg:grid-cols-5">
    <div class="lg:col-span-3">
      <h2 class="text-xl font-bold text-brand-900">Tell us about the damage</h2>
      <p class="mt-2 text-sm text-brand-600">
        The more detail the better — room, rough size, whether it is wet, and what is above or
        behind it. Photos help most of all.
      </p>
      <div class="mt-6 rounded-2xl border border-brand-100 p-6">
        <QuoteForm id="contact-form" />
      </div>
    </div>

    <aside class="space-y-8 lg:col-span-2">
      <div class="rounded-2xl bg-brand-50 p-6">
        <h2 class="text-sm font-bold uppercase tracking-wider text-brand-900">Reach us directly</h2>
        <p class="mt-4 text-sm text-brand-700">
          <a class="text-lg font-bold text-brand-900 hover:text-accent-700" href={PHONE_HREF}
            >{PHONE_DISPLAY}</a
          ><br />
          <a class="hover:text-accent-700" href={`mailto:${COMPANY_EMAIL}`}>{COMPANY_EMAIL}</a>
        </p>
        <p class="mt-4 text-sm text-brand-600">{HOURS}</p>
      </div>

      <div class="rounded-2xl border border-brand-100 p-6">
        <h2 class="text-sm font-bold uppercase tracking-wider text-brand-900">
          What speeds up your quote
        </h2>
        <ul class="mt-4 space-y-2.5 text-sm text-brand-700">
          <li class="flex gap-2.5">
            <span class="text-accent-500" aria-hidden="true">▪</span>
            <span>A wide photo of the room plus a close-up of the damage</span>
          </li>
          <li class="flex gap-2.5">
            <span class="text-accent-500" aria-hidden="true">▪</span>
            <span>A raking-light photo so we can identify the texture</span>
          </li>
          <li class="flex gap-2.5">
            <span class="text-accent-500" aria-hidden="true">▪</span>
            <span>Roughly when the house was built</span>
          </li>
          <li class="flex gap-2.5">
            <span class="text-accent-500" aria-hidden="true">▪</span>
            <span>Ceiling height, if it is above about ten feet</span>
          </li>
          <li class="flex gap-2.5">
            <span class="text-accent-500" aria-hidden="true">▪</span>
            <span>Whether anything is still wet</span>
          </li>
        </ul>
      </div>

      <div class="rounded-2xl border border-brand-100 p-6">
        <h2 class="text-sm font-bold uppercase tracking-wider text-brand-900">Service areas</h2>
        <p class="mt-3 text-sm leading-relaxed text-brand-600">
          {cities.map((c) => c.name).join(', ')}.
        </p>
        <a
          href="/locations/"
          class="mt-4 inline-block text-sm font-semibold text-accent-600 hover:text-accent-700"
          >See all service areas →</a
        >
      </div>
    </aside>
  </section>
</Layout>
