---
import {
  SITE_NAME,
  SITE_URL,
  SITE_TAGLINE,
  PHONE_DISPLAY,
  PHONE_HREF,
  COMPANY_EMAIL,
  CSLB_LICENSE,
  HOURS,
  REGION_LONG,
  NAV_LINKS,
} from '../lib/utils';
import { cities } from '../data/cities';
import { services } from '../data/services';

export interface Props {
  title: string;
  description: string;
  canonical: string;
  schemas?: unknown[];
  noindex?: boolean;
}

const { title, description, canonical, schemas = [], noindex = false } = Astro.props;
const canonicalUrl = `${SITE_URL}${canonical}`;
const year = 2026;
const footerCities = cities.slice(0, 20);
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    {noindex && <meta name="robots" content="noindex,follow" />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#2a3a55" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta name="twitter:card" content="summary" />

    {
      schemas.map((s) => (
        <script type="application/ld+json" set:html={JSON.stringify(s)} />
      ))
    }
  </head>

  <body class="bg-white text-brand-900 antialiased">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded focus:bg-brand-900 focus:px-4 focus:py-2 focus:text-white"
      >Skip to content</a
    >

    <!-- Top bar -->
    <div class="hidden bg-brand-900 text-brand-100 md:block">
      <div class="mx-auto flex max-w-6xl items-center justify-between px-4 py-2 text-sm">
        <p>{SITE_TAGLINE}</p>
        <p class="flex items-center gap-4">
          <span class="text-brand-300">{HOURS}</span>
          <a class="font-semibold text-white hover:text-accent-300" href={PHONE_HREF}>
            {PHONE_DISPLAY}
          </a>
        </p>
      </div>
    </div>

    <!-- Header -->
    <header class="sticky top-0 z-40 border-b border-brand-100 bg-white/95 backdrop-blur">
      <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-3">
        <a href="/" class="flex items-center gap-2.5 font-bold tracking-tight">
          <span
            class="grid h-9 w-9 place-items-center rounded-lg bg-brand-800 text-sm font-black text-white"
            aria-hidden="true">DV</span
          >
          <span class="leading-tight">
            <span class="block text-base text-brand-900">Diablo Valley</span>
            <span class="block text-[0.7rem] font-semibold uppercase tracking-[0.18em] text-accent-600"
              >Drywall</span
            >
          </span>
        </a>

        <nav aria-label="Primary" class="hidden items-center gap-6 lg:flex">
          {
            NAV_LINKS.slice(0, 4).map((l) => (
              <a
                href={l.href}
                class="text-sm font-medium text-brand-700 transition hover:text-accent-600"
              >
                {l.label}
              </a>
            ))
          }
        </nav>

        <div class="flex items-center gap-2">
          <a
            href={PHONE_HREF}
            class="hidden rounded-lg border border-brand-200 px-3 py-2 text-sm font-semibold text-brand-800 transition hover:border-brand-400 sm:block"
            >{PHONE_DISPLAY}</a
          >
          <a
            href="/contact/"
            class="rounded-lg bg-accent-600 px-4 py-2 text-sm font-bold text-white shadow-sm transition hover:bg-accent-700"
            >Get a Quote</a
          >
        </div>
      </div>
    </header>

    <main id="main" class="pb-24 lg:pb-0">
      <slot />
    </main>

    <!-- Footer -->
    <footer class="border-t border-brand-800 bg-brand-900 text-brand-200">
      <div class="mx-auto max-w-6xl px-4 py-12">
        <div class="grid gap-10 md:grid-cols-4">
          <div class="md:col-span-1">
            <p class="text-lg font-bold text-white">{SITE_NAME}</p>
            <p class="mt-2 text-sm leading-relaxed">
              Drywall repair, ceiling repair and texture matching across {REGION_LONG}.
            </p>
            <p class="mt-4 text-sm">
              <a class="font-semibold text-white hover:text-accent-300" href={PHONE_HREF}
                >{PHONE_DISPLAY}</a
              ><br />
              <a class="hover:text-accent-300" href={`mailto:${COMPANY_EMAIL}`}>{COMPANY_EMAIL}</a
              ><br />
              <span class="text-brand-400">{HOURS}</span>
            </p>
          </div>

          <div>
            <p class="text-sm font-bold uppercase tracking-wider text-white">Services</p>
            <ul class="mt-3 space-y-2 text-sm">
              {
                services.map((s) => (
                  <li>
                    <a class="hover:text-accent-300" href={`/services/${s.slug}/`}>
                      {s.name}
                    </a>
                  </li>
                ))
              }
            </ul>
          </div>

          <div class="md:col-span-2">
            <p class="text-sm font-bold uppercase tracking-wider text-white">Service Areas</p>
            <ul class="mt-3 grid grid-cols-2 gap-x-4 gap-y-2 text-sm sm:grid-cols-3">
              {
                footerCities.map((c) => (
                  <li>
                    <a class="hover:text-accent-300" href={`/locations/${c.slug}/`}>
                      {c.name}
                    </a>
                  </li>
                ))
              }
            </ul>
            <p class="mt-4 text-sm">
              <a class="font-semibold text-white hover:text-accent-300" href="/locations/"
                >All service areas →</a
              >
            </p>
          </div>
        </div>

        <div
          class="mt-10 flex flex-col gap-3 border-t border-brand-800 pt-6 text-xs text-brand-400 sm:flex-row sm:items-center sm:justify-between"
        >
          <p>© {year} {SITE_NAME}. All rights reserved.</p>
          <p class="flex flex-wrap gap-4">
            <a class="hover:text-white" href="/blog/">Guides</a>
            <a class="hover:text-white" href="/locations/">Service Areas</a>
            <a class="hover:text-white" href="/contact/">Contact</a>
          </p>
        </div>

        {
          CSLB_LICENSE && (
            <p class="mt-4 text-xs text-brand-500">CSLB License #{CSLB_LICENSE}</p>
          )
        }
      </div>
    </footer>

    <!-- Sticky mobile call bar -->
    <div
      class="fixed inset-x-0 bottom-0 z-40 grid grid-cols-2 gap-px border-t border-brand-800 bg-brand-800 lg:hidden"
    >
      <a
        href={PHONE_HREF}
        class="flex items-center justify-center gap-2 bg-brand-900 py-3.5 text-sm font-bold text-white"
      >
        <span aria-hidden="true">📞</span> Call now
      </a>
      <a
        href="/contact/"
        class="flex items-center justify-center gap-2 bg-accent-600 py-3.5 text-sm font-bold text-white"
      >
        <span aria-hidden="true">✉️</span> Get a quote
      </a>
    </div>

    <script is:inline>
      // Redirect non-trailing-slash URLs to the trailing-slash version.
      // Bolt hosting serves /path/ and /path as the same file, so Google
      // can index both. This 301-equivalent redirect consolidates them.
      (function () {
        var url = new URL(window.location.href);
        var path = url.pathname;
        if (
          path.length > 1 &&
          !path.endsWith('/') &&
          !path.endsWith('.xml') &&
          !path.endsWith('.txt') &&
          !path.endsWith('.svg') &&
          !path.endsWith('.png') &&
          !path.endsWith('.jpg') &&
          !path.endsWith('.ico') &&
          !path.includes('.')
        ) {
          url.pathname = path + '/';
          window.history.replaceState(null, '', url.toString());
        }
      })();
    </script>
  </body>
</html>
